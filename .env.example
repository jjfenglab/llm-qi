# Copy this file to .env (which is gitignored) and fill in your own values.
# python-dotenv loads .env automatically when the pipeline starts.

# --- LLM provider credentials ---
# Set credentials for any provider whose models you intend to call. lab_llm
# picks the provider based on the model string configured in the sconscripts.

# OpenAI (gpt-* models, including the GPT-5 family used in early iterations).
# The repo accepts the standard OPENAI_API_KEY; lab_llm's native name is
# OPENAI_ACCESS_TOKEN and either works (see src/common.py).
OPENAI_API_KEY=sk-...

# AWS Bedrock (Claude Opus / Haiku — the models in the published v8/v9 runs).
BEDROCK_ACCESS_KEY=...
BEDROCK_ACCESS_KEY_SECRET=...
# Optional override if you use a private Bedrock endpoint.
# BEDROCK_ENDPOINT_URL=https://...

# --- Pipeline inputs ---
# Path to your local readmission EHR database (DuckDB or SQLite). Required by
# exp_readmission; see src/assemble_readmission_notes.py for the expected
# schema.
READMISSION_DB=/absolute/path/to/your_readmission.db
