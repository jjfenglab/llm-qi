import os
from os.path import join as path_join

from dotenv import load_dotenv
from nestly import Nest
from nestly.scons import SConsWrap
from SCons.Script import Import

load_dotenv()

# For SCons - Import env from parent
Import("env")
localenv = env.Clone()

# Path to the source EHR database. Set the READMISSION_DB environment variable
# (or your .env) to the absolute path of your local DuckDB/SQLite database;
# see src/assemble_readmission_notes.py for the expected schema.
READMISSION_DATABASE = os.environ.get("READMISSION_DB", "")
assert READMISSION_DATABASE, (
    "READMISSION_DB environment variable is not set. Point it at your EHR "
    "database; see src/assemble_readmission_notes.py for the expected schema."
)

# Available prompt versions for readmission extraction
PROMPT_VERSIONS_DICT = {
    # "v1": {
    #    "limit": 4,
    #    "seed": 42,
    #    "max_char": 1000000,
    #    "llm_model": "us.anthropic.claude-opus-4-5-20251101-v1:0",
    #    "reviewer_id": "jean luke rob jim", # only read the first reason
