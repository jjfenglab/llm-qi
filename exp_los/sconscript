from os.path import join as path_join

from dotenv import load_dotenv
from nestly import Nest
from nestly.scons import SConsWrap
from SCons.Script import Import

load_dotenv()

# For SCons - Import env from parent
Import("env")
localenv = env.Clone()

# Available prompt versions for LOS extraction
PROMPT_VERSIONS_DICT = {
    # "v1": {
    #    "limit": 50
    #    "llm_model": "gpt-5-mini-2025-08-07",
    # }
    # "v2": { # jean solo wrote improvement from v1 to v2, jean solo review v2
    #    "limit": 5
    #    "llm_model": "gpt-5-mini-2025-08-07",
    # },
    # "v3": { # jean solo wrote improvement from v1 to v2, jean solo review v3
    #    "limit": 10,
    #    "seed": 3,
    #    "max_char": 1000000,
    #    "llm_model": "gpt-5-mini-2025-08-07",
    # },
    # "v4": { # jean solo wrote improvement from v3 to v4, jean and luke dual review v4
    #    "limit": 10,
    #    "seed": 3,
    #    "max_char": 1000000,
    #    "llm_model": "gpt-5-2025-08-07",
    # },
    # "v5": { # jean updates prompt based on luke review from v4 to v5, luke solo review v5
    #    "limit": 10,
    #    "seed": 3,
    #    "max_char": 1000000,
    #    "llm_model": "us.anthropic.claude-opus-4-5-20251101-v1:0",
    # },
    # "v6": { # jean updates prompt based on luke review from v5 to v6, luke solo review v6
    #    "limit": 5, # actually hardcoded to specific encounters to match prior reviews, more helpful since we had prior annotations, much easier to iterate
    #    "seed": 3,
    #    "max_char": 1000000,
    #    "llm_model": "us.anthropic.claude-opus-4-5-20251101-v1:0",
    # },
    # "v7": { # jean updates prompt based on luke review from v6 to v7, group kickoff session v7
    #    "limit": 52,
    #    "seed": 10,
    #    "max_char": 1000000,
    #    "reviewer_id": "luke ross hemal toff rob dana",
    #    "num_read_all": 4,
    #    "llm_model": "us.anthropic.claude-opus-4-5-20251101-v1:0",
    # },
    # "v8": { # jean updates prompt based on group kickoff session from v7 to v8, group review v8
    #    "limit": 52,
    #    "seed": 10,
    #    "max_char": 1000000,
    #    "reviewer_id": "luke ross hemal toff rob dana",
    #    "num_read_all": 4,
    #    "llm_model": "us.anthropic.claude-opus-4-5-20251101-v1:0",
    # },
    "v9": {  # group review passed, so just run the same exact thing with v8 prompts but with more patients
        # Two-stage pipeline: Gantt extraction + Reasons extraction (separate LLM calls)
        # Reduces timeout errors by simplifying each schema
        "limit": 502,
        "seed": 10,
        "max_char": 1000000,
        "reviewer_id": None,
        "num_read_all": None,
        "llm_model": "us.anthropic.claude-opus-4-5-20251101-v1:0",
        "two_stage": True,  # Flag to use two-stage pipeline
    },
}
PROMPT_VERSIONS = list(PROMPT_VERSIONS_DICT.keys())
MIN_CONFIDENCE = 70

# Cache configuration for LLM calls
CACHE_FILE = "los_cache.db"

# Set up nestly state
nest = SConsWrap(Nest(), localenv["output"], alias_environment=localenv)

# LLM Configuration
LLM_DICT = {
    "batch_size": 10,
    "max_retries": 1,
    "temperature": {
        "gpt-4o-2024-08-06": 0,
        "gpt-5-mini-2025-08-07": 1,
        "gpt-5-2025-08-07": 1,
        "us.anthropic.claude-haiku-4-5-20251001-v1:0": 1,
        "us.anthropic.claude-opus-4-5-20251101-v1:0": 1,
    },
}

# Clustering parameters
CLUSTERING_CONFIGS = {
    "default": {
        "min_cluster_size": 10,
        "embedding_model": "all-MiniLM-L6-v2",
    },
}

# LOS filtering parameters
LOS_CONFIG = {
    "min_los": 4,
    "max_los": 30,
    "seed": 42,
}


# Source data paths by ICD code
SOURCE_DATA = {
    "t40": "exp_los/data/t40_all_timelines.csv",
    "sepsis": "exp_los/data/sepsis_all_timelines_10_14.csv",
    "i63": "exp_los/data/i63_all_timelines.csv",
    "l03": "exp_los/data/l03_all_timelines.csv",
    "s06": "exp_los/data/s06_all_timelines.csv",
    "all": "exp_los/data/s06_all_timelines.csv exp_los/data/l03_all_timelines.csv exp_los/data/i63_all_timelines.csv exp_los/data/sepsis_all_timelines_10_14.csv exp_los/data/t40_all_timelines.csv",
}

nest.add(
    "icd",
    [
        "all",
    ],
)


@nest.add_target_with_env(localenv)
def assemble_los_notes(env, outdir, c):
    """Phase 1: Assemble and filter notes by LOS range"""
    source_csv = SOURCE_DATA[c["icd"]]

    cmd = [
        "python src/assemble_los_notes.py",
        "--source-csv",
        source_csv,
        "--output-csv ${TARGETS[0]}",
        "--min-los",
        LOS_CONFIG["min_los"],
        "--max-los",
        LOS_CONFIG["max_los"],
        "--seed",
        LOS_CONFIG["seed"],
    ]

    targets = [path_join(outdir, "assembled_notes.csv")]
    return env.Command(targets, [], " ".join(map(str, cmd)))


nest.add("prompt_version", PROMPT_VERSIONS, label_func=lambda c: "prompt_%s" % c)


@nest.add_target_with_env(localenv)
def extract_gantt_charts(env, outdir, c):
    """Phase 2a: Extract Gantt charts using LLM (two-stage pipeline only)"""
    prompt_config = PROMPT_VERSIONS_DICT[c["prompt_version"]]

    # Only run for two-stage pipeline versions
    if not prompt_config.get("two_stage", False):
        return

    llm_model = prompt_config["llm_model"]
    prompt_template_path = f"exp_los/prompts/{c['prompt_version']}_gantt_template.txt"

    cmd = [
        "python src/extract_gantt_chart.py",
        "--input-csv ${SOURCES[0]}",
        "--output-json ${TARGETS[0]}",
        "--prompt-template",
        prompt_template_path,
        "--cache-db",
        CACHE_FILE,
        "--log-file ${TARGETS[1]}",
        "--model",
        llm_model,
        "--batch-size",
        LLM_DICT["batch_size"],
        "--max-retries",
        LLM_DICT["max_retries"],
        "--temperature",
        LLM_DICT["temperature"][llm_model],
        "--limit",
        prompt_config["limit"],
    ]
    if "seed" in prompt_config:
        cmd += ["--random-seed", prompt_config["seed"]]
    if "max_char" in prompt_config:
        cmd += ["--max-char", prompt_config["max_char"]]

    sources = [
        c["assemble_los_notes"][0],
    ]
    targets = [
        path_join(outdir, "gantt_charts.json"),
        path_join(outdir, "log_gantt_extraction.txt"),
    ]

    return env.Command(targets, sources, " ".join(map(str, cmd)))


@nest.add_target_with_env(localenv)
def extract_reasons(env, outdir, c):
    """Phase 2/2b: Extract LOS reasons using LLM

    Single-call mode (v1-v8): Extracts Gantt chart + reasons together
    Two-stage mode (v9+): Uses existing Gantt charts and extracts only reasons
    """
    prompt_config = PROMPT_VERSIONS_DICT[c["prompt_version"]]
    llm_model = prompt_config["llm_model"]
    two_stage = prompt_config.get("two_stage", False)

    # Construct prompt template path based on version
    prompt_template_path = (
        f"exp_los/prompts/{c['prompt_version']}_extraction_template.txt"
    )

    cmd = [
        "python src/extract_reasons.py",
        "--input-csv ${SOURCES[0]}",
        "--output-csv ${TARGETS[0]}",
        "--prompt-template",
        prompt_template_path,
        "--cache-db",
        CACHE_FILE,
        "--log-file ${TARGETS[1]}",
        "--model",
        llm_model,
        "--batch-size",
        LLM_DICT["batch_size"],
        "--max-retries",
        LLM_DICT["max_retries"],
        "--temperature",
        LLM_DICT["temperature"][llm_model],
        "--limit",
        prompt_config["limit"],
    ]
    if "seed" in prompt_config:
        cmd += ["--random-seed", prompt_config["seed"]]
    if "max_char" in prompt_config:
        cmd += ["--max-char", prompt_config["max_char"]]

    sources = [c["assemble_los_notes"][0]]

    if two_stage:
        # Two-stage mode: use existing Gantt charts from extract_gantt_charts
        cmd += ["--input-gantt-json ${SOURCES[1]}"]
        sources.append(c["extract_gantt_charts"][0])  # gantt_charts.json
        targets = [
            path_join(outdir, "extracted_reasons.csv"),
            path_join(outdir, "log_extraction.txt"),
        ]
    else:
        # Single-call mode: generate Gantt charts alongside reasons
        cmd += ["--output-gantt-json ${TARGETS[2]}"]
        targets = [
            path_join(outdir, "extracted_reasons.csv"),
            path_join(outdir, "log_extraction.txt"),
            path_join(outdir, "gantt_charts.json"),
        ]

    return env.Command(targets, sources, " ".join(map(str, cmd)))


@nest.add_target_with_env(localenv)
def score_confidences(env, outdir, c):
    """Phase 2b: Score confidence for extracted reasons using LLM"""
    prompt_config = PROMPT_VERSIONS_DICT[c["prompt_version"]]
    llm_model = prompt_config["llm_model"]
    two_stage = prompt_config.get("two_stage", False)
    prompt_template_path = f"exp_los/prompts/{c['prompt_version']}_scoring_template.txt"

    cmd = [
        "python src/score_confidences.py",
        "--input-csv ${SOURCES[0]}",
        "--output-csv ${TARGETS[0]}",
        "--gantt-json ${SOURCES[1]}",
        "--notes-csv ${SOURCES[2]}",
        "--prompt-template",
        prompt_template_path,
        "--cache-db",
        CACHE_FILE,
        "--log-file ${TARGETS[1]}",
        "--model",
        llm_model,
        "--batch-size",
        LLM_DICT["batch_size"],
        "--max-retries",
        LLM_DICT["max_retries"],
        "--temperature",
        LLM_DICT["temperature"][llm_model],
    ]
    if "seed" in prompt_config:
        cmd += ["--random-seed", prompt_config["seed"]]

    # Gantt charts come from different source in two-stage mode
    if two_stage:
        gantt_source = c["extract_gantt_charts"][
            0
        ]  # gantt_charts.json from extract_gantt_charts
    else:
        gantt_source = c["extract_reasons"][2]  # gantt_charts.json from extract_reasons

    sources = [
        c["extract_reasons"][0],  # extracted_reasons.csv
        gantt_source,
        c["assemble_los_notes"][0],  # assembled_notes.csv
    ]
    targets = [
        path_join(outdir, "scored_reasons.csv"),
        path_join(outdir, "log_confidence_scoring.txt"),
    ]

    return env.Command(targets, sources, " ".join(map(str, cmd)))


@nest.add_target_with_env(localenv)
def generate_validation_ui(env, outdir, c):
    """Generate HTML validation interface"""
    prompt_config = PROMPT_VERSIONS_DICT[c["prompt_version"]]
    two_stage = prompt_config.get("two_stage", False)

    if prompt_config["reviewer_id"] is None:
        return
    cmd = [
        "python ui/start_validation_app.py",
        "--db-path exp_los/annotations.db",
        "--assembled-notes-csv ${SOURCES[0]}",
        "--extracted-reasons-csv ${SOURCES[1]}",
        "--gantt-json ${SOURCES[2]}",
        "--prompt-id",
        f"exp_los_{c['prompt_version']}",
        "--calibration",
        "monotone_ordinal",
        "--reviewer-id",
        prompt_config["reviewer_id"],
        "--num-read-all",
        str(prompt_config["num_read_all"]),
        '--rating-statement-completion "streamline patient flow"',
        "--export ${TARGETS[0]}",
    ]
    targets = [path_join(outdir, "validation.html")]

    # Gantt charts come from different source in two-stage mode
    if two_stage:
        gantt_source = c["extract_gantt_charts"][0]
    else:
        gantt_source = (
            c["extract_reasons"][2]
            if len(c["extract_reasons"]) > 2
            else c["extract_reasons"][1]
        )

    sources = [
        c["assemble_los_notes"][0],
        c["score_confidences"][0],
        gantt_source,
    ]
    return env.Command(targets, sources, " ".join(map(str, cmd)))


# Manual annotation upload and offline analysis are run separately, e.g.
#   python src/upload_annotations.py --prompt-id exp_los_v<N> \
#       --input-csv exp_los/annotations/validations_<reviewer>.csv \
#       --db-path exp_los/annotations.db
#   python src/analyze_annotations.py --prompt-id exp_los_v<N> \
#       --db-path exp_los/annotations.db \
#       --calibration-model monotone_ordinal


nest.add("clustering_config", list(CLUSTERING_CONFIGS.keys()))


@nest.add_target_with_env(localenv)
def cluster_reasons(env, outdir, c):
    """Phase 3: Cluster reasons using BERTopic"""
    if c["prompt_version"] != "v9":
        # only v9 gets to cluster and reach this step
        return
    clustering_config = CLUSTERING_CONFIGS[c["clustering_config"]]

    targets = [
        path_join(outdir, "clustered_reasons.csv"),
        path_join(outdir, "topic_summaries.csv"),
        path_join(outdir, "topic_model.pkl"),
        path_join(outdir, "cluster_members.json"),
    ]

    cmd = [
        "python src/cluster_reasons.py",
        "--input-csv ${SOURCES[0]}",
        "--clustered-reasons-csv ${TARGETS[0]}",
        "--topic-summaries-csv ${TARGETS[1]}",
        "--topic-model-pkl ${TARGETS[2]}",
        "--cluster-members-json ${TARGETS[3]}",
        "--min-confidence",
        MIN_CONFIDENCE,
        "--n-neighbors 10",
        "--n-clusters 30",
        "--min-cluster-size",
        clustering_config["min_cluster_size"],
        "--embedding-model",
        clustering_config["embedding_model"],
    ]

    sources = [c["score_confidences"][0]]  # filtered_reasons.csv

    return env.Command(targets, sources, " ".join(map(str, cmd)))


# The cluster_members.json produced above is then manually cleaned with an LLM
# into cluster_members_gemini_clean.json (see "Cleaning BERTopic cluster names"
# in the top-level README) before tag_themes runs.


@nest.add_target_with_env(localenv)
def tag_themes(env, outdir, c):
    """Phase 4: Tag filtered reasons with themes using LLM"""
    if c["prompt_version"] != "v9":
        return

    llm_model = PROMPT_VERSIONS_DICT[c["prompt_version"]]["llm_model"]
    prompt_template_path = "exp_los/prompts/theme_tagging_template.txt"
    # Note: cluster_members_gemini_clean.json is manually created after cluster_reasons
    themes_json_path = path_join("exp_los", outdir, "cluster_members_gemini_clean.json")

    cmd = [
        "python src/tag_themes.py",
        "--input-csv ${SOURCES[0]}",
        "--themes-json",
        themes_json_path,
        "--output-csv ${TARGETS[0]}",
        "--prompt-template",
        prompt_template_path,
        "--cache-db",
        CACHE_FILE,
        "--log-file ${TARGETS[1]}",
        "--model us.anthropic.claude-haiku-4-5-20251001-v1:0",
        "--batch-size",
        LLM_DICT["batch_size"],
        "--min-confidence",
        MIN_CONFIDENCE,
        "--max-retries",
        LLM_DICT["max_retries"],
        "--temperature",
        LLM_DICT["temperature"][llm_model],
    ]

    sources = [c["score_confidences"][0]]  # filtered_reasons.csv
    targets = [
        path_join(outdir, "tagged_reasons.csv"),
        path_join(outdir, "log_theme_tagging.txt"),
    ]

    return env.Command(targets, sources, " ".join(map(str, cmd)))


@nest.add_target_with_env(localenv)
def plot_themes(env, outdir, c):
    """Phase 5: Plot theme distribution"""
    if c["prompt_version"] != "v9":
        return

    themes_json_path = path_join("exp_los", outdir, "cluster_members_gemini_clean.json")

    cmd = [
        "python src/plot_themes.py",
        "--input-csv ${SOURCES[0]}",
        "--themes-json",
        themes_json_path,
        "--theme-distribution-reasons-png ${TARGETS[0]}",
        "--theme-distribution-encounters-png ${TARGETS[1]}",
        "--theme-summary-csv ${TARGETS[2]}",
    ]

    sources = [c["tag_themes"][0]]  # tagged_reasons.csv
    targets = [
        path_join(outdir, "theme_distribution_reasons.png"),
        path_join(outdir, "theme_distribution_encounters.png"),
        path_join(outdir, "theme_summary.csv"),
    ]

    return env.Command(targets, sources, " ".join(map(str, cmd)))
